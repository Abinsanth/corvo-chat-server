[Unit]
Description=corvo-chat server
After=network-online.target
Wants=network-online.target

[Service]
User=corvo-chat
Group=corvo-chat
ExecStart=/usr/local/bin/corvo-chat-server serve
# Creates /var/lib/corvo-chat owned by corvo-chat: the certificate cache, later the database and server key.
StateDirectory=corvo-chat
StateDirectoryMode=0700
# Each open connection holds a file handle; the default soft limit is 1024.
LimitNOFILE=65536
# Port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The rest of the sandbox: no devices, kernel knobs, namespaces or odd syscalls.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
